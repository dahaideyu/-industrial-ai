# MQTT 配置
MQTT_BROKER=CHANGE_ME
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASS=CHANGE_ME
MQTT_QOS=1


# Topic 配置
MQTT_TOPIC=Gycs/chaowei/btr
