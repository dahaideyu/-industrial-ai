# ============================================
# 超维AI平台 — 环境变量配置示例
# 复制此文件为 docker/.env 并填入真实值
# ============================================

# ========================================
# 模型供应商配置
# ========================================
# 模型供应商（默认使用 DeepSeek）
PROVIDER=deepseek

# ========================================
# DeepSeek 配置 (PROVIDER=deepseek 时使用)
# ========================================
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# ========================================
# Qwen (阿里灵积) 配置 (PROVIDER=qwen3 时使用)
# ========================================
QWEN3_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN3_API_KEY=sk-your-qwen-key-here
QWEN3_MODEL=qwen-plus

# ========================================
# OpenAI 配置 (PROVIDER=openai 时使用)
# ========================================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4

# ========================================
# 本地模型配置 (PROVIDER=local_qwen3 时使用)
# ========================================
LOCAL_QWEN3_BASE_URL=http://10.1.1.4:8001/v1
LOCAL_QWEN3_API_KEY=dummy-key
LOCAL_QWEN3_MODEL=qwen3.5-27b


# ========================================
# PostgreSQL (TimescaleDB) - 统一数据存储
# ========================================
# 本地开发可选用容器化 TimescaleDB（免隧道）：
#   docker compose -f deploy/docker/docker-compose.yml --profile local-db up -d postgresql
# 首次启动（空数据卷）会自动跑 docker/init-sql/ 下的脚本建表。
# 所有应用表统一放在 knowledge_base 库中（设备参数 + 知识库 + AI报告 + Agentic QA）。
# 取值对照（两种跑法二选一）：
#   ① 全容器部署（deploy.bat / docker compose 跑 backend、mqtt-etl）：
#      PG_HOST=postgresql、PG_PORT=5432（容器网络内用服务名直连）
#   ② 宿主机裸跑 backend（start.bat）+ 容器只跑数据库：
#      PG_HOST=127.0.0.1、PG_PORT=15432（走宿主机映射端口，跟 PG_HOST_PORT 一致）
#   注意容器内 127.0.0.1 是容器自己，写 127.0.0.1:5432 两种跑法都连不上。

# PostgreSQL 故障转移主机（可选）
PG_FALLBACK_HOST=

# PG_* — 所有模块统一的 PostgreSQL 连接配置
# 连库参数全项目统一用 PG_*，默认值只在 backend/core/pg_env.py 定义一处。
# 旧名 KNB_PG_* / DB_* / POSTGRES_* 仍能读到，但会打印废弃告警，请勿在新部署里使用。
PG_HOST=postgresql          # 容器内填服务名；宿主机直连填 127.0.0.1
PG_PORT=5432                # 容器内部端口；宿主机直连用下面的 PG_HOST_PORT
PG_DB=knowledge_base
PG_USER=zxzz
PG_PASSWORD=your-password
PG_HOST_PORT=15432          # 宿主机映射端口（避开宿主机自带 PG 的 5432）
# 经企业代理/隧道访问时设 disable：SSL 会被 DPI 干扰报 "SSL error: unexpected eof"
PG_SSLMODE=
PG_CONNECT_TIMEOUT=10


# ========================================
# MQTT ETL 服务配置
# ========================================
# MQTT ETL 服务通过 --profile mqtt 启动：
#   docker compose -f deploy/docker/docker-compose.yml --profile mqtt up -d mqtt-etl
# 数据库连接已复用上面的 POSTGRES_* 变量，无需单独配置
MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=
MQTT_TOPIC_NH=
MQTT_USER=
MQTT_PASS=
MQTT_QOS=1


# ========================================
# 上游系统配置（测试环境）
# ========================================
UPSTREAM_MOCK=false
UPSTREAM_BASE_URL=10.1.2.116:18081
UPSTREAM_SECRET=CHANGE_ME
UPSTREAM_TIMEOUT=30
UPSTREAM_RETRY_COUNT=3


# ========================================
# 定时任务调度器配置（测试环境启用）
# ========================================
# 是否启用定时任务调度器
# true = 启用定时任务，按 cron 表达式自动执行
# false = 禁用定时任务，只能手动调用 API 触发
ENABLE_REPORT_SCHEDULER=true

# ============================================
# Cron 表达式格式说明
# ============================================
# 格式: 分钟 小时 日 月 周
# 示例:
#   "30 5 * * *"  = 每天早上 5:30
#   "0 9 * * 1-5" = 工作日早上 9:00
#   "0 */2 * * *" = 每 2 小时
#   "0 6 1 * *"   = 每月1号早上 6:00
#
# ⚠️ day_of_week 使用 APScheduler 格式（与标准 cron 不同!）:
#   0=周一, 1=周二, 2=周三, 3=周四, 4=周五, 5=周六, 6=周日
# ============================================

# 精益早会日报定时执行的 cron 表达式
LEAN_MORNING_DAILY_CRON=30 5 * * *

# 精益早会日报傍晚版（当天白班数据，T+0），留空=禁用
LEAN_MORNING_DAILY_EVENING_CRON=

# 是否启用批量生成模式
# true  = 一次性生成所有车间/工序的早会日报（推荐生产环境使用）
# false = 单工序模式，只生成下面配置的单个车间/工序的报告
LEAN_MORNING_DAILY_BATCH_ENABLED=true

# 批量模式下指定要生成的车间 ID 列表（逗号分隔）
# 留空 = 生成所有车间的报告（默认）
# 示例: "1,2,3" = 只生成车间 1、2、3 的报告
# 测试环境建议配置少量车间，避免消耗过多资源
LEAN_MORNING_DAILY_WORKSHOP_IDS=1,2

# ─── 以下是单工序模式的配置（BATCH_ENABLED=false 时生效） ───

# 单工序模式下的默认车间 ID
# 仅当 LEAN_MORNING_DAILY_BATCH_ENABLED=false 时生效
LEAN_MORNING_DAILY_WORKSHOP_ID=1

# 单工序模式下的默认工序 ID
# 仅当 LEAN_MORNING_DAILY_BATCH_ENABLED=false 时生效
LEAN_MORNING_DAILY_PROCEDURE_ID=2


# ========================================
# 质量报告定时任务配置
# ========================================

# 质量日报定时执行的 cron 表达式
# 默认: 留空 = 禁用
# 质量概览报告
QUALITY_DAILY_CRON=0 7 * * *
QUALITY_WEEKLY_CRON=0 7 * * 0
QUALITY_MONTHLY_CRON=0 7 1 * *


# ========================================
# 设备效率报告定时任务配置
# ========================================
# 设备效率日报定时执行的 cron 表达式
# 格式: 分钟 小时 日 月 周
# 默认: 每天早上 5:20
DEVICE_EFFICIENCY_DAILY_CRON=0 6 * * *

# 设备效率周报定时执行的 cron 表达式
# 默认: 每周一早上 5:20
# 留空 = 禁用该定时任务
DEVICE_EFFICIENCY_WEEKLY_CRON=0 6 * * 0

# 设备效率月报定时执行的 cron 表达式
# 默认: 每月1号早上 5:20
# 留空 = 禁用该定时任务
DEVICE_EFFICIENCY_MONTHLY_CRON=0 6 1 * *

# 设备效率报告的车间 ID（可选，留空表示仅工厂级）
# 批量模式（优先）：逗号分隔多个车间 ID
# 示例: "1,2" = 同时生成车间 1 和车间 2 的报告
DEVICE_EFFICIENCY_WORKSHOP_IDS=

# 单车间模式（批量为空时生效）
# 留空 = 仅工厂级报告
DEVICE_EFFICIENCY_WORKSHOP_ID=

# 设备运维报告
DEVICE_MAINTENANCE_WEEKLY_CRON=0 6 * * 0
DEVICE_MAINTENANCE_MONTHLY_CRON=0 6 1 * *


# ========================================
# 日志级别（测试环境用 INFO）
# ========================================
LOG_LEVEL=INFO


# ========================================
# RAGFlow 知识库平台（报告生成 + 知识库管理 + 维修建议/报警诊断共用）
# ragflow_api_url 由代码自动从 RAGFLOW_BASE_URL 派生，无需单独配置
# 取值注意（跟上面 POSTGRES_HOST 同一个坑）：backend 容器化部署时 localhost 指
#   容器自己，必须写 RAGFlow 所在机器的 IP——即使 RAGFlow 就自建在同一台宿主机
#   （自建方式见 deploy/ragflow/），也要写宿主机内网 IP，如 http://10.x.x.x:9380；
#   只有宿主机裸跑 backend 且 RAGFlow 在本机时才能用 localhost。
# 换 RAGFlow 实例（如外部实例换成自建）时，下面的 API key/数据集/助手 ID 都要在
#   新实例里重新生成/创建后回填，跟旧实例不通用（清单见 deploy/ragflow/README.md）。
# ========================================
RAGFLOW_BASE_URL=http://your-ragflow-host:9380
RAGFLOW_API_KEY=your-ragflow-api-key
RAGFLOW_EMBEDDING_MODEL=text-embedding-v4@Tongyi-Qianwen@Tongyi-Qianwen
RAGFLOW_MODEL=qwen-plus

# RAGFlow 特定配置（Agentic QA 用，可选）
RAGFLOW_CONVERSATION_ID=
RAGFLOW_DATASET_ID=

# RAGFlow 聊天助手 ID（在 RAGFlow 界面创建助手后填入其 ID）
# DOC_ASSISTANT_ID: 设备文档助手——维修建议(repair-suggestion)工单评分 + 参数报警诊断共用
#   （报警诊断可用 DEVICE_PARAM_ALERT_KB_CHAT_ID 单独覆盖）
# HISTORY_ASSISTANT_ID: 维修历史助手——维修建议(repair-suggestion)用
# 不配则相应功能拿不到知识库检索结果
RAGFLOW_DOC_ASSISTANT_ID=
RAGFLOW_HISTORY_ASSISTANT_ID=

# ========================================
# AQA MySQL 业务数据库（Agentic QA + 知识库管理共用）
# ========================================
AQA_MYSQL_HOST=CHANGE_ME
AQA_MYSQL_PORT=3306
AQA_MYSQL_USER=zxzz
AQA_MYSQL_PASSWORD=CHANGE_ME
AQA_MYSQL_DATABASE=jxcw

# ========================================
# Agentic QA 智能问答平台
# ========================================
ENABLE_SQL_QA=false
# 知识库问答认证模式：统一使用主应用 HMAC 令牌（设为 true，否则 /kb-qa 会用独立 JWT+SQLite 认证导致 401）
SQL_QA_UNIFIED_AUTH=true

# 应用数据库（留空则自动复用上方 PG_* 配置连接到 knowledge_base 库）
# 旧部署如仍有 SQLite 数据需迁移，联系管理员执行 migrate_sqlite_to_pg.py
AQA_DATABASE_URL=

# Vanna
AQA_VANNA_MODEL=deepseek
AQA_VANNA_CHROMA_PATH=./backend/data/agentic_qa/vanna-knowledge
AQA_ENTITY_CHROMA_PATH=./backend/data/agentic_qa/entity-knowledge

# Neo4j（可选，不可用时自动降级）
AQA_NEO4J_URI=neo4j://localhost:7687
AQA_NEO4J_USER=neo4j
AQA_NEO4J_PASSWORD=

# 应用配置
AQA_APP_ENV=development
AQA_APP_SECRET_KEY=dev-secret-change-in-production
AQA_GRAPH_MAPPING_PATH=backend/config/graph_mapping.yaml

# ========================================
# 知识库管理模块（独有配置，共用配置已在上方）
# ========================================
ENABLE_KNOWLEDGE_BASE=true

# 基地标识
KNB_LOCATION=江西基地

# ---- 系统级共享 Redis ----
REDIS_URL=redis://redis:6379/1

# ---- 系统级共享 MinIO ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME@Zxzz
MINIO_BUCKET=knowledge-base


# 设备类型同步
KNB_SYNC_ENABLED=true
KNB_SYNC_API_KEY=changeme

# ========================================
# PLC 解析服务配置
# ========================================
# PLC解析模型API配置
PLC_DASHSCOPE_API_KEY=sk-your-dashscope-key-here
PLC_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型配置
PLC_VISION_MODEL=qwen3-vl-plus
PLC_TEXT_MODEL=qwen3.7-plus

 # 超时配置（秒）
PLC_VISION_TIMEOUT=120.0
PLC_TEXT_TIMEOUT=180.0
PLC_MAX_RETRIES=3

# PDF 处理配置
PLC_PDF_DPI=300

# ========================================
# 源码编译保护与提示词加密配置
# ========================================
# 是否启用 Cython 源码编译（true=编译成.so, false=保留.py源码）
COMPILE_SOURCE=true

# 提示词读取模式（auto=自动, file=仅明文, encrypted=仅加密）
PROMPT_SOURCE=auto

# 提示词加密密钥（由 encrypt_prompts.py 生成，部署时填入）
PROMPT_ENCRYPT_KEY=34jYyYFaoyzhrvEw5OVI857BWibY5V8cYi59ka7steg=

# Docker 镜像名称和标签（用于 docker-compose 离线部署）
# 必须与 build.bat 打包的镜像名一致（industrial-ai），否则 docker load 之后
# compose up 找不到同名镜像会在服务器上重新触发构建
# 实际会用到 3 个镜像（build.bat/build.sh 会依次构建并打包全部三个）：
#   ${IMAGE_NAME}         → industrial-ai 服务（含 nginx+前端+LibreOffice）
#   ${IMAGE_NAME}-worker  → knb-celery-worker 服务（含 LibreOffice+OCR）
#   ${IMAGE_NAME}-lean    → repair-suggestion/mqtt-etl 服务（纯后端运行时）
IMAGE_NAME=industrial-ai
IMAGE_TAG=latest