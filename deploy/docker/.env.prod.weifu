IMAGE_NAME=industrial-ai
IMAGE_TAG=latest

# 数据库故障转移（可选）
PG_FALLBACK_HOST=

# 构建参数（docker compose 构建时读取宿主机环境变量）
COMPILE_SOURCE=true
