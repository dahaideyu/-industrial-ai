# ========================================
# 永旭环境配置
# ========================================

# 模型供应商
PROVIDER=opencode

# ========================================
# OpenCode 配置 (PROVIDER=opencode 时使用)
# ========================================
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=CHANGE_ME
OPENCODE_MODEL=deepseek-v4-flash

# ========================================
# RAGFlow 知识库配置（生产环境）
# ========================================
RAGFLOW_BASE_URL=http://10.11.40.211:9380
RAGFLOW_API_KEY=CHANGE_ME
RAGFLOW_CONVERSATION_ID=
RAGFLOW_DATASET_ID=9592565c858e11f1b92ff754f686351a

# ========================================
# 维修工单评分服务
# ========================================
REPAIR_SUGGESTION_PORT=8000
RAGFLOW_HISTORY_ASSISTANT_ID=
RAGFLOW_DOC_ASSISTANT_ID=


# ========================================
# 上游系统配置（生产环境）
# ========================================
UPSTREAM_MOCK=false
UPSTREAM_BASE_URL=http://192.168.129.90:18081
UPSTREAM_SECRET=CHANGE_ME
UPSTREAM_TIMEOUT=300
UPSTREAM_RETRY_COUNT=3

# ========================================
# 功能模块开关
# ========================================

# 知识库管理模块（需要 PostgreSQL + Redis + MinIO + Celery）
# true = 启用知识库文档管理和 RAG 检索
# false = 仅运行报告生成服务
ENABLE_KNOWLEDGE_BASE=true

# 知识库首页展示基地
KNB_LOCATION=永旭

# 知识库同步 API Key
KNB_SYNC_API_KEY=changeme
KNB_SYNC_ENABLED=true

# ---- 系统级共享 PostgreSQL（容器内 PostgreSQL 服务）----
PG_HOST=postgresql
PG_PORT=5432
PG_DB=knowledge_base
PG_USER=zxzz
PG_PASSWORD=CHANGE_ME@Zxzz


# 兼容旧名

# ---- 系统级共享 Redis ----
REDIS_URL=redis://redis:6379/1

# ---- 系统级共享 MinIO ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME@Zxzz
MINIO_BUCKET=knowledge-base


# 视觉模型配置（合规性文档检测）
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus
VISION_TIMEOUT=120.0

# ========================================
# 定时任务调度器配置（生产环境启用）
# ========================================

# 是否启用定时任务调度器
# true = 启用定时任务，按 cron 表达式自动执行
# false = 禁用定时任务，只能手动调用 API 触发
ENABLE_REPORT_SCHEDULER=true

# 精益早会日报定时执行的 cron 表达式
# 格式: 分钟 小时 日 月 周
# 示例:
#   "57 8 * * *"  = 每天早上 8:57 执行
#   "0 9 * * 1-5" = 工作日（周一到周五）早上 9:00 执行
#   "0 */2 * * *" = 每 2 小时执行一次
# 默认值: 57 8 * * *（每天早上 8:57）
LEAN_MORNING_DAILY_CRON=30 5 * * *

# 精益早会日报傍晚版（当天白班数据，T+0），留空=禁用
LEAN_MORNING_DAILY_EVENING_CRON=30 17 * * *

# 是否启用批量生成模式
# true  = 一次性生成所有车间/工序的早会日报（推荐生产环境使用）
# false = 单工序模式，只生成下面配置的单个车间/工序的报告
LEAN_MORNING_DAILY_BATCH_ENABLED=true

# 批量模式下指定要生成的车间 ID 列表（逗号分隔）
# 留空 = 生成所有车间的报告（默认）
# 示例: "1,2,3" = 只生成车间 1、2、3 的报告
LEAN_MORNING_DAILY_WORKSHOP_IDS=

# ─── 以下是单工序模式的配置（BATCH_ENABLED=false 时生效） ───

# 单工序模式下的默认车间 ID
# 仅当 LEAN_MORNING_DAILY_BATCH_ENABLED=false 时生效
LEAN_MORNING_DAILY_WORKSHOP_ID=35

# 单工序模式下的默认工序 ID
# 仅当 LEAN_MORNING_DAILY_BATCH_ENABLED=false 时生效
LEAN_MORNING_DAILY_PROCEDURE_ID=27

# ========================================
# 质量报告定时任务配置
# ========================================

# 质量日报定时执行的 cron 表达式
# 格式: 分钟 小时 日 月 周
# 示例:
#   "30 5 * * *"  = 每天早上 5:30 执行
#   "0 8 * * 1-5" = 工作日早上 8:00 执行
QUALITY_DAILY_CRON=0 7 * * *

# 质量周报定时执行的 cron 表达式
# 示例: "30 5 * * 1" = 每周一早上 5:30 执行
QUALITY_WEEKLY_CRON=0 7 * * 0

# 质量月报定时执行的 cron 表达式
# 示例: "30 5 1 * *" = 每月1号早上 5:30 执行
QUALITY_MONTHLY_CRON=0 7 1 * *

# 设备效率日报定时执行的 cron 表达式
# 格式: 分钟 小时 日 月 周
# 默认: 每天早上 6:00
DEVICE_EFFICIENCY_DAILY_CRON=0 6 * * *

# 设备效率周报定时执行的 cron 表达式
# 默认: 每周一早上 6:00
DEVICE_EFFICIENCY_WEEKLY_CRON=0 6 * * 0

# 设备效率月报定时执行的 cron 表达式
# 默认: 每月1号早上 6:00
DEVICE_EFFICIENCY_MONTHLY_CRON=0 6 1 * *

# 设备效率报告的车间 ID（可选，留空表示仅工厂级）
# 批量模式（优先）：逗号分隔多个车间 ID
# 示例: "1,2" = 同时生成车间 1 和车间 2 的报告
DEVICE_EFFICIENCY_WORKSHOP_IDS=

# 单车间模式（批量为空时生效）
# 留空 = 仅工厂级报告
DEVICE_EFFICIENCY_WORKSHOP_ID=

# ========================================
# 设备运维报告定时任务配置
# ========================================
# cron 表达式格式: 分钟 小时 日 月 周
# day_of_week: 0=周一, 1=周二, ..., 6=周日
# 留空 = 禁用该定时任务

# 设备运维周报，默认每周一早上 6:00
DEVICE_MAINTENANCE_WEEKLY_CRON=0 6 * * 0

# 设备运维月报，默认每月1号早上 6:00
DEVICE_MAINTENANCE_MONTHLY_CRON=0 6 1 * *

# ========================================
# 日志级别（生产环境用 INFO）
# ========================================
LOG_LEVEL=INFO


# --------------------------------------------
# SQL-QA 智能问答平台
# 设置为 true 将 SQL-QA 路由并入主应用（端口 9300）
# SQL-QA 独立部署时使用 .env.sqlqa
# --------------------------------------------
ENABLE_SQL_QA=false
# 知识库问答认证模式：统一使用主应用 HMAC 令牌（设为 true，否则 /kb-qa 会用独立 JWT+SQLite 认证导致 401）
SQL_QA_UNIFIED_AUTH=true

# MySQL（被查询的业务数据库）
AQA_MYSQL_HOST=
AQA_MYSQL_PORT=3306
AQA_MYSQL_USER=
AQA_MYSQL_PASSWORD=
AQA_MYSQL_DATABASE=

# Vanna
AQA_VANNA_MODEL=deepseek
AQA_VANNA_CHROMA_PATH=./backend/data/agentic_qa/vanna-knowledge
AQA_ENTITY_CHROMA_PATH=./backend/data/agentic_qa/entity-knowledge

# Neo4j（可选，不可用时自动降级）
AQA_NEO4J_URI=
AQA_NEO4J_USER=
AQA_NEO4J_PASSWORD=

# 应用配置
AQA_APP_ENV=production
AQA_APP_SECRET_KEY=dev-secret-change-in-production
# 应用数据库（留空自动复用 PG_* 配置连接 knowledge_base）
AQA_DATABASE_URL=
AQA_GRAPH_MAPPING_PATH=config/graph_mapping.yaml

# PLC 解析服务配置
PLC_DASHSCOPE_API_KEY=CHANGE_ME
PLC_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLC_VISION_MODEL=qwen3-vl-plus
PLC_TEXT_MODEL=qwen3.7-plus
PLC_VISION_TIMEOUT=120.0
PLC_TEXT_TIMEOUT=180.0
PLC_MAX_RETRIES=3
PLC_PDF_DPI=300

# ========================================
# MQTT ETL 服务配置（永旭环境）
# ========================================
MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=
MQTT_TOPIC_NH=
MQTT_USER=
MQTT_PASS=
MQTT_QOS=1

# 构建参数（docker compose 构建时读取宿主机环境变量）
COMPILE_SOURCE=true
# 提示词加载模式（file=明文文件，encrypted=加密，auto=自动检测）
PROMPT_SOURCE=encrypted
PROMPT_ENCRYPT_KEY=LN9kisb6XJ6D4FOvgPlKRaKN_9odH6J3HEK08ZXFffs=

